# Copy to .env and fill in real values. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DATABASE_URL=
# Docker monitoring scope (explicit allowlist, comma-separated Compose project names)
# NOTE: no DEPLOYIQ_ prefix — Settings has no env_prefix, so this exact name is required.
MONITORED_PROJECTS=
# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
