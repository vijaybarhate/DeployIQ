# Copy to .env and fill in real values. Never commit .env.
OPENROUTER_API_KEY=
# Optional extra keys for the pooled availability check (teammates' keys):
# OPENROUTER_API_KEY1, OPENROUTER_API_KEY2, ... up to _9. Health checks fail
# over across keys on rate limits, so one exhausted key never hides a model
# that another key can still reach.
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
OPENROUTER_MODEL=
# Default SQLite URL (app launched from backend/). Do not leave blank:
# pydantic-settings reads empty values verbatim and would override this.
DATABASE_URL=sqlite:///./deployiq.db
# Docker monitoring scope (explicit allowlist, comma-separated Compose project names)
# NOTE: no DEPLOYIQ_ prefix — Settings has no env_prefix, so this exact name is required.
MONITORED_PROJECTS=
# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
